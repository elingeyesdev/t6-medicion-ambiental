APP_NAME=GeoSur
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Solo backend. No compartir .env ni la clave en URLs de clientes o capturas.
NASA_FIRMS_CLAVE=

# Token público de lectura pk. de Mapbox. Se utiliza en el navegador para el mapa.
# No usar tokens secretos sk. ni guardar un valor real en Git.
MAPBOX_PUBLIC_TOKEN=

# Consulta externa solo mediante el comando geosur:capturar-tiempo y una autorización explícita.
# Las consultas de la pantalla y la API siempre leen la base local.
GEOSUR_TIEMPO_HABILITADO=false

# Capas: directorio privado local. Vacío usa storage/app/private/mapas/raster.
# No colocar originales, datos privados ni tokens secretos en public/.
# MAPAS_RASTER_DIRECTORIO=
MAPAS_POI_HABILITADO=false
MAPAS_POI_TOKEN=

# Ingestión de sensores: habilitar solo con broker y temas propios revisados.
GEOSUR_MQTT_HABILITADO=false
GEOSUR_MQTT_URL=
GEOSUR_MQTT_USUARIO=
GEOSUR_MQTT_CLAVE=
GEOSUR_MQTT_CLIENTE=geosur-datos-local
GEOSUR_MQTT_CA=
GEOSUR_MQTT_ESPERA=5
GEOSUR_MQTT_TEMAS=

# Reportes de modelos: ninguna consulta externa se ejecuta al abrir una pantalla.
GEOSUR_REPORTES_ATMOSFERA_HABILITADO=false
GEOSUR_REPORTES_METEO_URL=https://api.open-meteo.com/v1/forecast
GEOSUR_REPORTES_AIRE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
GEOSUR_REPORTES_METEO_CLAVE=

# Avisos externos apagados. Credenciales y destinos solo en el entorno privado.
AVISOS_PROCESAR=false
AVISOS_EMAIL_HABILITADO=false
AVISOS_EMAIL_MAILER=log
AVISOS_TELEGRAM_HABILITADO=false
AVISOS_TELEGRAM_TOKEN=
AVISOS_WHATSAPP_HABILITADO=false
AVISOS_WHATSAPP_TOKEN=
AVISOS_WHATSAPP_TELEFONO_ID=
AVISOS_WHATSAPP_VERSION=
AVISOS_WHATSAPP_PLANTILLA=
AVISOS_WHATSAPP_IDIOMA=es
AVISOS_PUSH_HABILITADO=false
AVISOS_PUSH_PROYECTO=
AVISOS_PUSH_CLIENTE_EMAIL=
AVISOS_PUSH_CLAVE_PRIVADA=
AVISOS_PUSH_API_KEY_PUBLICA=
AVISOS_PUSH_APP_ID=
AVISOS_PUSH_SENDER_ID=
AVISOS_PUSH_VAPID_PUBLICA=
MAIL_TIMEOUT=10

# Actualizador GFS local. Activar solo con el entorno raster preparado.
MAPAS_ACTUALIZACION_HABILITADA=false
MAPAS_ACTUALIZACION_PYTHON=

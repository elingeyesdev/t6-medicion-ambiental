{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versionContrato",
    "tipoEvidencia",
    "estado",
    "comparacion",
    "territorio",
    "fuente",
    "cobertura",
    "resumen",
    "capa",
    "advertencias"
  ],
  "properties": {
    "versionContrato": {
      "const": "agua-0.1-candidata"
    },
    "tipoEvidencia": {
      "enum": [
        "prueba_controlada",
        "resultado_validado"
      ]
    },
    "estado": {
      "enum": [
        "cambio_agua_observado",
        "sin_cambios",
        "sin_datos"
      ]
    },
    "comparacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referencia",
        "comparacion"
      ],
      "properties": {
        "referencia": {
          "type": "string",
          "format": "date"
        },
        "comparacion": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "territorio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identificador",
        "nombre",
        "alcance"
      ],
      "properties": {
        "identificador": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "alcance": {
          "const": "recorte_parcial"
        }
      }
    },
    "fuente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nombre",
        "producto",
        "metodo",
        "resolucionMetros",
        "escenas"
      ],
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "producto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metodo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resolucionMetros": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "escenas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "cobertura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaEstudiadaKm2",
        "areaComparableKm2",
        "fraccionComparable"
      ],
      "properties": {
        "areaEstudiadaKm2": {
          "type": "number",
          "minimum": 0
        },
        "areaComparableKm2": {
          "type": "number",
          "minimum": 0
        },
        "fraccionComparable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "resumen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aguaPersistenteKm2",
        "aguaNuevaKm2",
        "aguaRetiradaKm2",
        "inundacionConfirmada"
      ],
      "properties": {
        "aguaPersistenteKm2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aguaNuevaKm2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aguaRetiradaKm2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "inundacionConfirmada": {
          "type": "null"
        }
      }
    },
    "capa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "properties",
              "geometry"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clase"
                ],
                "properties": {
                  "clase": {
                    "enum": [
                      "agua_persistente",
                      "agua_nueva",
                      "agua_retirada",
                      "no_comparable"
                    ]
                  }
                }
              },
              "geometry": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 10000,
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "advertencias": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "maxItems": 10
    }
  }
}
